# Copy this file to .env and fill in the values.
# Used by docker compose (env_file: ./orchestrator/.env) and local uv runs.

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── GitHub MCP (optional) ─────────────────────────────────────────────────────
# Remote GitHub MCP endpoint; set a PAT in config.yaml under
# mcp.github.headers.Authorization when enabling the GitHub tool.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# ── Redis (optional — not required by the orchestrator core) ──────────────────
# If running Redis via compose, set REDIS_HOST to the service name (e.g. redis).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=drain3
REDIS_SSL=false

# ── Drain3 log deduplication (optional) ───────────────────────────────────────
DRAIN3_SIMILARITY_THRESHOLD=0.4
DRAIN3_MAX_DEPTH=4
DRAIN3_MAX_CHILDREN=100
DRAIN3_KEY_TTL_SECONDS=1800

# ── Analysis limits (optional) ────────────────────────────────────────────────
ANALYSIS_LOG_LIMIT=500

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# Set OTEL_ENABLED=true and an OTLP endpoint to activate ADK-native tracing at
# startup (invoke_workflow → invoke_agent → execute_tool spans in Jaeger).
# Jaeger UI: http://localhost:16686  (docker compose --profile observability up)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=orchestrator
# When running with: docker compose --profile observability up
# set this to the Jaeger gRPC receiver inside the compose network:
#   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Disable OpenAI Agents SDK's own tracing when OTEL is active
OPENAI_AGENTS_DISABLE_TRACING=1

# Workflow execution logs (start/step/finish) use ORCHESTRATOR_LOG_LEVEL.
# Set ORCHESTRATOR_LOG_LEVEL=DEBUG for per-ADK-event workflow.event lines.

# ── PostgreSQL (storage) ──────────────────────────────────────────────────────
# Async SQLAlchemy URL (uses asyncpg driver). Overrides config.yaml database.url.
# Local uv against compose Postgres (host is localhost):
# ORCHESTRATOR_DATABASE__URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator
# Docker Compose sets the in-network URL for the orchestrator service automatically.

# ── API key security ──────────────────────────────────────────────────────────
# Pepper used when hashing tenant API keys. REQUIRED in production — set to a
# long random string and keep it secret. Rotate by re-minting all active keys.
# ORCHESTRATOR_AUTH__API_KEY_PEPPER=

# ── Orchestrator overrides (optional) ─────────────────────────────────────────
# ORCHESTRATOR_DEBUG=false
# ORCHESTRATOR_LOG_LEVEL=INFO
